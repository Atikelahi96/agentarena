# PostgreSQL (the database is created automatically if the user may CREATE DATABASE)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/agentarena

# Meta Model API (OpenAI-compatible). Either name works.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Optional: minimal | low | medium | high | max
META_REASONING_EFFORT=

# Meta open-weight models on partner inference (optional)
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/muse-spark-open
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open

RUN_CONCURRENCY=4
CORS_ORIGINS=http://localhost:3000

# Spend protection for a public deployment (see app/limits.py)
# DAILY_TOKEN_BUDGET caps real-model tokens per UTC day (0 = off). ~3M tokens is a few dollars of Muse Spark.
DAILY_TOKEN_BUDGET=0
PUBLIC_MODE=false
PUBLIC_MAX_RUNS=24
PUBLIC_LAUNCHES_PER_HOUR=6
PUBLIC_MODELS=muse-spark-1.3,muse-spark-1.3@minimal,simulated
# Send as X-Admin-Token to bypass per-visitor limits (never the daily budget). Use a long random value.
ADMIN_TOKEN=
